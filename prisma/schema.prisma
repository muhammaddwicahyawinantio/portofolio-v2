// DwiStudio — MySQL schema.
// Bilingual fields pakai suffix _en / _id. `order` dipakai untuk drag-sort di CMS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id             String   @id @default(cuid())
  title_en       String
  title_id       String
  slug           String   @unique
  description_en String   @db.Text
  description_id String   @db.Text
  caseStudy_en   String   @db.Text
  caseStudy_id   String   @db.Text
  category       String
  role           String
  year           String
  client         String?
  link           String?
  coverImage     String?
  images         Json // array of image/video URL strings; type inferred by extension
  featured       Boolean  @default(false)
  archived       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

model Website {
  id             String @id @default(cuid())
  name           String
  url            String
  thumbnail      String
  description_en String @db.Text
  description_id String @db.Text
  order          Int    @default(0)

  @@index([order])
}

model Service {
  id             String  @id @default(cuid())
  name_en        String
  name_id        String
  description_en String  @db.Text
  description_id String  @db.Text
  icon           String
  priceLabel     String
  features_en    Json
  features_id    Json
  benefits_en    Json
  benefits_id    Json
  image          String?
  // Tujuan tombol Explore, cerminan Product.link. Tidak ada /services/{slug}
  // di situs ini, jadi kosong -> jatuh ke /contact seperti CTA sebelumnya.
  link           String?
  order          Int     @default(0)

  @@index([order])
}

// Produk digital yang dijual lewat Lynk.id. `title` tunggal, bukan bilingual:
// isinya nama merek ("ChatGPT Plus") yang tidak diterjemahkan — pola yang sama
// dipakai Website.name dan FilmItem.title. Yang berupa prosa tetap _en/_id.
// Tidak ada kolom harga: checkout dan harganya dipegang halaman Lynk.id, jadi
// menyimpannya di sini berarti dua sumber kebenaran yang bisa berbeda.
model Product {
  id             String  @id @default(cuid())
  title          String
  subtitle_en    String
  subtitle_id    String
  description_en String  @db.Text
  description_id String  @db.Text
  image          String?
  link           String
  order          Int     @default(0)

  @@index([order])
}

model Feature {
  id             String  @id @default(cuid())
  slug           String  @unique
  title_en       String
  title_id       String
  description_en String  @db.Text
  description_id String  @db.Text
  image          String?
  // Tujuan tombol Explore. Kosong -> jatuh ke /features/{slug}, halaman detail
  // yang memang sudah ada. Jadi kolom ini menimpa, bukan menggantikan, slug.
  link           String?
  order          Int     @default(0)

  @@index([order])
}

// Singleton (pola FooterContent) — hero homepage, dulu hardcoded di i18n.
// headline disimpan multi-baris: satu baris teks = satu baris judul. Baris
// pertama tegak, sisanya italic — persis bentuk "One studio. / Five mediums."
// yang sudah tampil, tapi jumlah barisnya bebas.
model HeroSection {
  id              String  @id @default("hero")
  backgroundImage String?
  headline_en     String  @db.Text
  headline_id     String  @db.Text
  subheadline_en  String?
  subheadline_id  String?
  ctaText_en      String?
  ctaText_id      String?
  ctaUrl          String?
}

// Alasan klien memilih studio ini. `icon` emoji, bukan unggahan: pola yang
// sama dengan Service.icon, dan satu karakter tidak butuh berkas.
model Benefit {
  id             String @id @default(cuid())
  icon           String
  title_en       String
  title_id       String
  description_en String @db.Text
  description_id String @db.Text
  order          Int    @default(0)

  @@index([order])
}

// Singleton. Kolom kanan section Contact di homepage — QR code + labelnya.
model ContactSettings {
  id         String  @id @default("contact")
  qrImage    String?
  qrLabel_en String?
  qrLabel_id String?
}

model About {
  id                  String  @id @default(cuid())
  title_en            String
  title_id            String
  location            String
  status_en           String
  status_id           String
  shortDescription_en String  @db.Text
  shortDescription_id String  @db.Text
  motto_en            String  @db.Text
  motto_id            String  @db.Text
  cvFile              String?
  fullStory_en        String  @db.Text
  fullStory_id        String  @db.Text
  // Array URL potret, bentuknya sama dengan Project.images dan dibaca lewat
  // toStringArray(). Halaman About menampilkannya sebagai DriftWall 5 kolom.
  images              Json?
}

model WorkExperience {
  id      String @id @default(cuid())
  company String
  role_en String
  role_id String
  period  String
  order   Int    @default(0)

  @@index([order])
}

model Education {
  id          String @id @default(cuid())
  institution String
  period      String
  order       Int    @default(0)

  @@index([order])
}

model Skill {
  id    String  @id @default(cuid())
  title String
  icon  String?
  order Int     @default(0)

  @@index([order])
}

model Certification {
  id    String  @id @default(cuid())
  name  String
  image String?
  order Int     @default(0)

  @@index([order])
}

model Testimonial {
  id         String  @id @default(cuid())
  clientName String
  position   String
  content_en String  @db.Text
  content_id String  @db.Text
  photo      String?
  order      Int     @default(0)

  @@index([order])
}

model MediaGalleryItem {
  id         String    @id @default(cuid())
  fileUrl    String
  fileType   MediaType @default(IMAGE)
  caption_en String?
  caption_id String?
  order      Int       @default(0)

  @@index([order])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Gallery3DItem {
  id             String @id @default(cuid())
  modelUrl       String
  thumbnail      String
  description_en String @db.Text
  description_id String @db.Text
  order          Int    @default(0)

  @@index([order])
}

model MusicItem {
  id       String @id @default(cuid())
  title    String
  audioUrl String
  cover    String
  order    Int    @default(0)

  @@index([order])
}

model FilmItem {
  id             String @id @default(cuid())
  title          String
  videoUrl       String
  thumbnail      String
  description_en String @db.Text
  description_id String @db.Text
  order          Int    @default(0)

  @@index([order])
}

// Singleton row (id = "footer") — CMS meng-upsert, tidak pernah create baru.
model FooterContent {
  id            String @id @default("footer")
  text_en       String @db.Text
  text_id       String @db.Text
  copyrightText String
}

model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String
  icon     String
  order    Int    @default(0)

  @@index([order])
}

model NavigationItem {
  id       String @id @default(cuid())
  label_en String
  label_id String
  url      String
  order    Int    @default(0)

  @@index([order])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model VisitorStat {
  id    String   @id @default(cuid())
  date  DateTime @unique @db.Date
  count Int      @default(0)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatar       String?
  createdAt    DateTime @default(now())
}
